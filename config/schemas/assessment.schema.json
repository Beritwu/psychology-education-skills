{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pebs/assessment",
  "title": "Assessment",
  "type": "object",
  "required": [
    "section_id",
    "items"
  ],
  "properties": {
    "section_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assessment_id",
          "kind",
          "question",
          "answer",
          "target_goal"
        ],
        "properties": {
          "assessment_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "hinge_question",
              "formative",
              "reflection_prompt"
            ]
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "type": "string"
          },
          "distractors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          },
          "target_goal": {
            "type": "string"
          },
          "claim_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_status": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "student_viewable": {
            "type": "boolean"
          },
          "answer_verification": {
            "type": "string"
          },
          "distractors_detail": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "answer",
                "misconception"
              ],
              "properties": {
                "answer": {
                  "type": "string"
                },
                "misconception": {
                  "type": "string"
                }
              }
            }
          },
          "response_patterns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "response_pattern",
                "linked_misconception"
              ],
              "properties": {
                "response_pattern": {
                  "type": "string",
                  "minLength": 1
                },
                "linked_misconception": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "type": "string"
                }
              }
            }
          },
          "retest_question": {
            "type": "object",
            "required": [
              "question",
              "answer"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "diagnostic_use": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "administration"
          ],
          "properties": {
            "administration": {
              "type": "string"
            },
            "decision_rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "assessment_ref",
                  "trigger",
                  "action"
                ],
                "properties": {
                  "assessment_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "trigger": {
                    "type": "string",
                    "minLength": 1
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "interpretation_boundary": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
